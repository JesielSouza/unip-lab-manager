# =============================================
# UNIP Lab Manager — Variáveis de Ambiente
# =============================================
# Copie este arquivo para .env e preencha os valores
# NUNCA suba o .env para o repositório!

# Chave secreta Flask — gere uma forte em produção
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-forte-aqui

# URL do banco de dados
# Dev (SQLite): não precisa definir, usa o padrão
# Produção (PostgreSQL no Railway):
# DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=

# Modo debug — nunca True em produção!
FLASK_DEBUG=false

# Porta (Railway define automaticamente)
PORT=5000

# Email (Gmail) para recuperação de senha
# Gere uma "App Password" no Google: https://myaccount.google.com/apppasswords
MAIL_USER=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app-gmail
